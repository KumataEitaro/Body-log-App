# native/ のビルド時に読む公開設定（EXPO_PUBLIC_* はアプリのバンドルに埋め込まれる＝秘密ではない値だけ置く）。
# 実際の値は同じ階層の .env（**git 管理**）にある。Codemagic / GitHub Actions はその .env からしか接続先を得ていない。
# .env を外すとログインできないビルドになる（2026-09-18〜21 に実際に起きた）。この雛形はキー名の一覧として置く。
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE=
# RevenueCat の公開SDKキー（Apple / Google）
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
# AdMob の広告ユニットID（未設定ならテスト用IDにフォールバック）
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
