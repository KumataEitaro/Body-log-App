{
  "expo": {
    "name": "BodyLog",
    "slug": "bodylog-native",
    "version": "1.0.19",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "scheme": "bodylog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gotcha.bodylog.rn",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "体重とワークアウトの記録をヘルスケアから読み取り、アプリのグラフや消費カロリー計算に反映するために使用します。",
        "NSHealthUpdateUsageDescription": "このアプリがヘルスケアへデータを書き込むことはありません。"
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.gotcha.bodylog.rn",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "作成した共有画像（透過ステッカー）を写真に保存するために使用します。",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "食事の写真からAIが栄養素を推定するために使用します。",
          "cameraPermission": "食事を撮影してAIが栄養素を推定するために使用します。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "食事の撮影と、パッケージのバーコードを読み取って公式データベースから栄養成分を取得するために使用します。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#059669"
        }
      ],
      "@react-native-community/datetimepicker",
      "@kingstinct/react-native-healthkit",
      "expo-localization",
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "_comment": "実App ID設定済み（2026-09-02・AdMob発行）。差し替え時は要再ビルド",
          "iosAppId": "ca-app-pub-3319916143033433~3403103040",
          "androidAppId": "ca-app-pub-3319916143033433~9006783518",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
